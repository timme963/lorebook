{
  "name": "lorebook",
  "version": "0.1.0",
  "description": "Lernen mit Story, Vorabfragen und Spaced Repetition – Inhalte per Prompt aus eigenem PDF",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/fetch-apk.mjs && wrangler pages deploy dist --project-name lorebook --branch main",
    "deploy:web-only": "npm run build && node scripts/copy-apk.mjs && wrangler pages deploy dist --project-name lorebook --branch main",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.16.22",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "private": true
}
