{
  "name": "lorebook",
  "version": "0.2.0",
  "description": "Lernen mit Story, Vorabfragen und Spaced Repetition – Inhalte per Prompt aus eigenem PDF",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/fetch-apk.mjs && wrangler pages deploy dist --project-name lorebook --branch main",
    "deploy:web-only": "npm run build && node scripts/copy-apk.mjs && wrangler pages deploy dist --project-name lorebook --branch main",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "format": "prettier --write src scripts e2e playwright.config.ts",
    "format:check": "prettier --check src scripts e2e playwright.config.ts",
    "lint": "eslint .",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "check": "tsc --noEmit && eslint . && prettier --check src scripts e2e playwright.config.ts && npm run licenses:check",
    "prepare": "git config core.hooksPath .githooks",
    "test:e2e": "playwright test"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  },
  "private": true
}
